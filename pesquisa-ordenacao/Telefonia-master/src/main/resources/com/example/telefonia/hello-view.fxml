<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="800.0" spacing="20.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.telefonia.TelefoniaController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label style="-fx-font-size: 20; -fx-font-weight: bold;" text="Sistema de Telefonia" />

    <Label text="Número do Celular:" />
    <TextField fx:id="campoNumero" prefWidth="300.0" promptText="Ex: 5591999123456" />

    <Button onAction="#buscarSessao" text="Buscar" />
    <Button onAction="#carregarDados" text="Carregar Dados" />

    <Label text="Resultado:" />
    <TextArea fx:id="areaResultado" prefHeight="400.0" prefWidth="760.0" />

    <Label fx:id="labelStatus" text="Status: Aguardando..." />
</VBox>
